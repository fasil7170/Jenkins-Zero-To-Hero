pipeline {
    agent {
        kubernetes {
            label 'ultimate-cicd-dind'
            defaultContainer 'jnlp'
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3.9.12-eclipse-temurin-17
    command:
    - cat
    tty: true
  - name: docker
    image: docker:24.0-dind
    securityContext:
      privileged: true
    command:
    - dockerd-entrypoint.sh
    tty: true
"""
        }
    }

    environment {
        DOCKER_IMAGE = "abhishekf5/ultimate-cicd:${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Code checkout done"
                // git branch: 'main', url: 'https://github.com/fasil7170/Jenkins-Zero-To-Hero.git'
            }
        }

        stage('Build and Test') {
            steps {
                container('maven') {
                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                        mvn clean package
                    '''
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                        sh '''
                            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                            mvn sonar:sonar \
                              -Dsonar.login=$SONAR_AUTH_TOKEN \
                              -Dsonar.host.url=http://192.168.0.100:9000
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh '''
                            echo "Starting Docker daemon..."
                            # Wait for Docker daemon to be ready
                            timeout=30
                            while (! docker info > /dev/null 2>&1) && [ $timeout -gt 0 ]; do
                                echo "Waiting for Docker daemon..."
                                sleep 2
                                timeout=$((timeout - 2))
                            done
                            docker login -u $DOCKER_USERNAME -p $DOCKER_PASSWORD
                            docker build -t ${DOCKER_IMAGE} java-maven-sonar-argocd-helm-k8s/spring-boot-app
                            docker push ${DOCKER_IMAGE}
                        '''
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'github-creds', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            git config user.email "rkftrip@gmail.com"
                            git config user.name "fasil7170"

                            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                            java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                            git add .
                            git commit -m "Update image to ${BUILD_NUMBER}"
                            git push https://${GITHUB_TOKEN}@github.com/fasil7170/Jenkins-Zero-To-Hero HEAD:main
                        '''
                    }
                }
            }
        }

    }
}
