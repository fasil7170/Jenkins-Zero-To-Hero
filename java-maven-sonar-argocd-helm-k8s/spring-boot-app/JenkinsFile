pipeline {
    agent {
        kubernetes {
            label 'ultimate-cicd-dind'
            defaultContainer 'jnlp'
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3.9.12-eclipse-temurin-17
    command: ['cat']
    tty: true

  - name: docker
    image: docker:24.0-dind
    securityContext:
      privileged: true
    env:
      - name: DOCKER_TLS_CERTDIR
        value: ""
    command:
    - dockerd-entrypoint.sh
    tty: true
"""
        }
    }

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE = "fazil2664/ultimate-cicd:${BUILD_NUMBER}"
        APP_DIR = "java-maven-sonar-argocd-helm-k8s/spring-boot-app"
        MANIFEST_DIR = "java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                container('maven') {
                    sh """
                        cd ${APP_DIR}
                        mvn clean package
                    """
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                        sh """
                            cd ${APP_DIR}
                            mvn sonar:sonar \
                              -Dsonar.login=${SONAR_AUTH_TOKEN} \
                              -Dsonar.host.url=http://192.168.0.100:9000
                        """
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh """
                            echo "Waiting for Docker daemon..."
                            until docker info > /dev/null 2>&1; do
                                sleep 2
                            done

                            echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin

                            docker build -t ${DOCKER_IMAGE} ${APP_DIR}
                            docker push ${DOCKER_IMAGE}

                            docker logout
                        """
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                container('maven') {

// 🔥 Add this line
            checkout scm
                    withCredentials([string(credentialsId: 'github-creds', variable: 'GITHUB_TOKEN')]) {
                        sh """
                            git config user.email "rkftrip@gmail.com"
                            git config user.name "fasil7170"

                            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                            ${MANIFEST_DIR}/deployment.yml

                            git add ${MANIFEST_DIR}/deployment.yml
                            git commit -m "Update image to ${BUILD_NUMBER}" || echo "No changes to commit"

                            git push https://${GITHUB_TOKEN}@github.com/fasil7170/Jenkins-Zero-To-Hero HEAD:main
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully 🚀"
        }
        failure {
            echo "Pipeline failed ❌"
        }
        always {
            cleanWs()
        }
    }
}
