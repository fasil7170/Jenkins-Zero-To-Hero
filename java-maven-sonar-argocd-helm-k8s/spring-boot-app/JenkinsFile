pipeline {
    agent any

    environment {
        GITHUB_REPO = "https://github.com/fasil7170/Jenkins-Zero-To-Hero.git"
        GITHUB_TOKEN = credentials('github-token')  // GitHub personal access token stored in Jenkins
        DOCKER_IMAGE = "fasil7170/spring-boot-app"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                echo "Checking out source code..."
                checkout([$class: 'GitSCM', 
                          branches: [[name: '*/main']], 
                          userRemoteConfigs: [[url: "${GITHUB_REPO}", credentialsId: 'github-token']]])
            }
        }

        stage('Build and Test') {
            steps {
                echo "Building Maven project..."
                sh 'mvn clean package'
            }
        }

        stage('Static Code Analysis') {
            steps {
                echo "Running SonarQube analysis..."
                withSonarQubeEnv('SonarQube') {  // Ensure 'SonarQube' matches your Jenkins server
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    echo "Building Docker image..."
                    def image = docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}")

                    echo "Pushing Docker image to Docker Hub..."
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {
                        image.push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s') {
                    script {
                        def filePath = "spring-boot-app-manifests/deployment.yml"
                        if (sh(script: "grep -q 'replaceImageTag' ${filePath}", returnStatus: true) == 0) {
                            echo "Updating image tag in deployment manifest..."
                            sh """
                                git config user.email "fasilmubarak07@gmail.com"
                                git config user.name "fasil7170"
                                sed -i 's/replaceImageTag/${BUILD_NUMBER}/g' ${filePath}
                                git add ${filePath}
                                git commit -m "Update image to ${BUILD_NUMBER}" --allow-empty
                                git push https://${GITHUB_TOKEN}@github.com/fasil7170/Jenkins-Zero-To-Hero.git main
                            """
                        } else {
                            echo "No placeholder 'replaceImageTag' found; skipping commit."
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning workspace..."
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed! Check logs."
        }
    }
}
