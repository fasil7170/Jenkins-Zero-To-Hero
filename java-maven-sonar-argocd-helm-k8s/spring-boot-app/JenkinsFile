podTemplate(
    label: 'kaniko-maven-pod',
    containers: [
        containerTemplate(
            name: 'jnlp',
            image: 'jenkins/inbound-agent:latest',
            args: '${computer.jnlpmac} ${computer.name}'
        ),
        containerTemplate(
            name: 'maven',
            image: 'maven:3.9.1-openjdk-17',
            ttyEnabled: true,
            command: 'cat'
        ),
        containerTemplate(
            name: 'kaniko',
            image: 'gcr.io/kaniko-project/executor:latest',
            ttyEnabled: true,
            command: '/busybox/sh',
            args: '-c'
        )
    ],
    imagePullSecrets: ['regcred'], // <-- Add your registry secret here
    volumes: [
        hostPathVolume(hostPath: '/var/run/docker.sock', mountPath: '/var/run/docker.sock')
    ]
) {
    node('kaniko-maven-pod') {
        container('kaniko') {
            sh """
                /kaniko/executor \\
                  --dockerfile=Dockerfile \\
                  --destination=myregistry/ultimate-demo:latest \\
                  --insecure \\
                  --insecure-pull \\
                  --skip-tls-verify
            """
        }
        container('maven') {
            sh 'mvn clean package'
        }
    }
}
