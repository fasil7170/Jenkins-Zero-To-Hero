pipeline {
    agent any
    environment {
        GITHUB_TOKEN = credentials('github-token')  // GitHub token stored in Jenkins
        DOCKER_CREDENTIALS = credentials('docker-hub-creds') // Docker hub credentials
    }

    stages {

        stage('Prepare Workspace') {
            steps {
                script {
                    // Ensure Git repo exists
                    if (!fileExists('.git')) {
                        echo "Repo missing, checking out SCM"
                        checkout scm
                    } else {
                        echo "Git repo already exists, skipping checkout"
                    }
                }
            }
        }

        stage('Build and Test') {
            steps {
                script {
                    echo "Running Build and Test..."
                    // Place your Maven/Gradle build commands here
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                script {
                    echo "Running static code analysis..."
                    // Example: sonar-scanner commands
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                container('docker') {
                    script {
                        echo "Building Docker image..."
                        sh """
                        docker login -u ${DOCKER_CREDENTIALS_USR} -p ${DOCKER_CREDENTIALS_PSW}
                        docker build -t my-app:${BUILD_NUMBER} .
                        docker push my-app:${BUILD_NUMBER}
                        """
                    }
                }
            }
        }
stage('Update Deployment File') {
    steps {
        container('your-container') { // container where git and sed are available
            withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
                script {
                    // Ensure Git repo exists
                    if (!fileExists('.git')) {
                        echo ".git directory missing, checking out repository..."
                        checkout scm
                    } else {
                        echo "Git repo found, skipping checkout."
                    }

                    // Update deployment file and commit changes safely
                    sh '''
                    # Configure Git user
                    git config user.email "abhishek.xyz@gmail.com"
                    git config user.name "Abhishek Veeramalla"

                    # Replace image tag in deployment YAML
                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                    # Stage changes
                    git add .

                    # Commit only if there are changes
                    git diff-index --quiet HEAD || git commit -m "Update image to ${BUILD_NUMBER}"

                    # Push changes to GitHub
                    git push https://${GITHUB_TOKEN}@github.com/fasil7170/Jenkins-Zero-To-Hero HEAD:main
                    '''
                }
            }
        }
    }
