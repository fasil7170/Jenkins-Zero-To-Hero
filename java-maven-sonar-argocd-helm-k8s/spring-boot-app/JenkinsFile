pipeline {
    agent {
        kubernetes {
            label 'ultimate-cicd-dind'
            defaultContainer 'jnlp'
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: docker
    image: docker:24.0-dind
    securityContext:
      privileged: true
    command:
    - dockerd-entrypoint.sh
    tty: true
"""
        }
    }

    environment {
        DOCKER_IMAGE = "fazil2664/ultimate-cicd:${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout Code') {
            steps {
                // Checkout repo so git commands will work
                checkout scm
            }
        }

        stage('Build, Test & Sonar Scan (Optional)') {
            steps {
                container('docker') {
                    sh """
                        # Build & test inside Maven docker image
                        docker run --rm -v ${env.WORKSPACE}:/workspace -w /workspace/java-maven-sonar-argocd-helm-k8s/spring-boot-app maven:3.9.12-eclipse-temurin-17 \
                        mvn clean package -DskipTests
                    """
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh """
                            echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin

                            # Build Docker image with multi-stage Dockerfile
                            docker build -t ${DOCKER_IMAGE} java-maven-sonar-argocd-helm-k8s/spring-boot-app

                            docker push ${DOCKER_IMAGE}
                        """
                    }
                }
            }
        }

        stage('Update Deployment YAML & Push') {
            steps {
                container('docker') {
                    withCredentials([string(credentialsId: 'github-creds', variable: 'GITHUB_TOKEN')]) {
                        dir("${env.WORKSPACE}") {
                            sh """
                                git config user.email "fasilmubarak07@gmail.com"
                                git config user.name "fasil7170"

                                # Update image tag in deployment YAML
                                sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                                java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml

                                git add java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml
                                
                                # Commit & push only if changes exist
                                if ! git diff --cached --quiet; then
                                    git commit -m "Update image to ${BUILD_NUMBER}"
                                    git push https://${GITHUB_TOKEN}@github.com/fasil7170/Jenkins-Zero-To-Hero HEAD:main
                                else
                                    echo "No changes to commit"
                                fi
                            """
                        }
                    }
                }
            }
        }

    } // end of stages
} // end of pipeline
