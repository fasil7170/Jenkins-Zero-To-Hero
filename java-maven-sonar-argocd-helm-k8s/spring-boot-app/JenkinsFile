pipeline {
    agent {
        kubernetes {
            label 'ultimate-cicd-dind'
            defaultContainer 'jnlp'
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3.9.12-eclipse-temurin-17
    command:
    - cat
    tty: true
  - name: docker
    image: docker:24.0-dind
    securityContext:
      privileged: true
    command:
    - dockerd-entrypoint.sh
    tty: true
"""
        }
    }

    environment {
        DOCKER_IMAGE = "fazil2664/ultimate-cicd:${BUILD_NUMBER}"
    }

    stages {

        stage('Checkout') {
            steps {
                container('maven') {
                    git branch: 'main', url: 'https://github.com/fasil7170/Jenkins-Zero-To-Hero.git'
                }
            }
        }

        stage('Build and Test') {
            steps {
                container('maven') {
                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                        mvn clean package
                    '''
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                        sh '''
                            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                            mvn sonar:sonar \
                              -Dsonar.login=$SONAR_AUTH_TOKEN \
                              -Dsonar.host.url=http://192.168.0.100:9000
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh '''
                            echo "Waiting for Docker daemon..."
                            timeout=30
                            until docker info > /dev/null 2>&1 || [ $timeout -le 0 ]; do
                                echo "Docker daemon not ready, waiting..."
                                sleep 2
                                timeout=$((timeout - 2))
                            done
                            if [ $timeout -le 0 ]; then
                                echo "Docker daemon failed to start"
                                exit 1
                            fi

                            echo $DOCKER_PASSWORD | docker login -u $DOCKER_USERNAME --password-stdin
                            docker build --pull -t ${DOCKER_IMAGE} java-maven-sonar-argocd-helm-k8s/spring-boot-app
                            docker tag ${DOCKER_IMAGE} fazil2664/ultimate-cicd:latest
                            docker push ${DOCKER_IMAGE}
                            docker push fazil2664/ultimate-cicd:latest
                        '''
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'github-creds', variable: 'GITHUB_TOKEN')]) {
                        sh '''
                            git config user.email "fasilmubarak07@gmail.com"
                            git config user.name "fasil7170"

                            FILE="java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"

                            if grep -q "replaceImageTag" "$FILE"; then
                                sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" "$FILE"
                                git add "$FILE"
                                git commit -m "Update image to ${BUILD_NUMBER}" --allow-empty
                                git push https://${GITHUB_TOKEN}@github.com/fasil7170/Jenkins-Zero-To-Hero.git main
                            else
                                echo "No placeholder found in $FILE; skipping commit."
                            fi
                        '''
                    }
                }
            }
        }

    }

    post {
        always {
            echo "Pipeline finished. Build number: ${BUILD_NUMBER}"
        }
        success {
            echo "Build succeeded!"
        }
        failure {
            echo "Build failed!"
        }
    }
}
