pipeline {
    agent {
        kubernetes {
            label 'ultimate-cicd-dind'
            defaultContainer 'jnlp'
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:latest
    args:
      - "$(JENKINS_SECRET)"
      - "$(JENKINS_NAME)"
    volumeMounts:
      - mountPath: /home/jenkins/agent
        name: workspace-volume

  - name: maven
    image: maven:3.9.12-eclipse-temurin-17
    command: ['cat']
    tty: true
    volumeMounts:
      - mountPath: /home/jenkins/agent
        name: workspace-volume

  - name: docker
    image: docker:24-dind
    securityContext:
      privileged: true
    env:
      - name: DOCKER_TLS_CERTDIR
        value: ""
    command: ['dockerd-entrypoint.sh']
    tty: true
    volumeMounts:
      - mountPath: /home/jenkins/agent
        name: workspace-volume
      - mountPath: /var/lib/docker
        name: docker-storage

  volumes:
    - name: workspace-volume
      emptyDir: {}
    - name: docker-storage
      emptyDir: {}
'''
        }
    }

    environment {
        IMAGE_NAME = "fazil2664/ultimate-cicd"
        IMAGE_TAG = "${BUILD_NUMBER}"
        FULL_IMAGE = "${IMAGE_NAME}:${IMAGE_TAG}"
        SONAR_HOST_URL = "http://192.168.0.100:9000"
        GIT_REPO = "https://github.com/fazil7170/Jenkins-Zero-To-Hero.git"
    }

    options {
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                container('maven') {
                    sh '''
                        cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                        mvn clean verify -B
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_TOKEN')]) {
                        sh '''
                            cd java-maven-sonar-argocd-helm-k8s/spring-boot-app
                            mvn sonar:sonar \
                              -Dsonar.login=$SONAR_TOKEN \
                              -Dsonar.host.url=$SONAR_HOST_URL
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            echo "Waiting for Docker daemon..."
                            timeout=60
                            until docker info > /dev/null 2>&1; do
                                sleep 2
                                timeout=$((timeout - 2))
                                if [ $timeout -le 0 ]; then
                                    echo "Docker daemon failed"
                                    exit 1
                                fi
                            done

                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin

                            docker build -t $FULL_IMAGE java-maven-sonar-argocd-helm-k8s/spring-boot-app
                            docker tag $FULL_IMAGE $IMAGE_NAME:latest

                            docker push $FULL_IMAGE
                            docker push $IMAGE_NAME:latest
                        '''
                    }
                }
            }
        }

        stage('Update Deployment Manifest') {
            steps {
                withCredentials([string(credentialsId: 'github-creds', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "ci@company.com"
                        git config user.name "jenkins-ci"

                        git checkout main

                        FILE="java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"

                        if [ -f "$FILE" ]; then
                            sed -i "s|image:.*|image: $FULL_IMAGE|g" $FILE
                            git add $FILE

                            if ! git diff --cached --quiet; then
                                git commit -m "Update image to $FULL_IMAGE"
                                git push https://${GITHUB_TOKEN}@github.com/fazil7170/Jenkins-Zero-To-Hero.git HEAD:main
                            else
                                echo "No manifest changes"
                            fi
                        else
                            echo "Deployment file not found!"
                            exit 1
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully"
        }
        failure {
            echo "❌ Pipeline failed"
        }
        always {
            cleanWs()
        }
    }
}
