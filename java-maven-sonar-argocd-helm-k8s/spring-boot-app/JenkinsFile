pipeline {
    agent any

    environment {
        GITHUB_REPO = "https://github.com/fasil7170/Jenkins-Zero-To-Hero.git"
        GITHUB_TOKEN = credentials('github-token')  // Make sure you have stored your GitHub token in Jenkins Credentials
        DOCKER_IMAGE = "fasil7170/spring-boot-app"
    }

    stages {
        stage('Checkout SCM') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Static Code Analysis') {
            steps {
                withSonarQubeEnv('SonarQube') {  // Replace 'SonarQube' with your Jenkins SonarQube server name
                    sh 'mvn sonar:sonar'
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                script {
                    docker.build("${DOCKER_IMAGE}:${BUILD_NUMBER}")
                    docker.withRegistry('https://index.docker.io/v1/', 'dockerhub-credentials') {  // Jenkins credential ID for Docker Hub
                        sh "docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}"
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('java-maven-sonar-argocd-helm-k8s') {
                    script {
                        FILE = "spring-boot-app-manifests/deployment.yml"
                        if (sh(script: "grep -q 'replaceImageTag' ${FILE}", returnStatus: true) == 0) {
                            sh """
                                git config user.email "fasilmubarak07@gmail.com"
                                git config user.name "fasil7170"
                                sed -i 's/replaceImageTag/${BUILD_NUMBER}/g' ${FILE}
                                git add ${FILE}
                                git commit -m "Update image to ${BUILD_NUMBER}" --allow-empty
                                git push https://${GITHUB_TOKEN}@github.com/fasil7170/Jenkins-Zero-To-Hero.git main
                            """
                        } else {
                            echo "No placeholder found in ${FILE}; skipping commit."
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Cleaning workspace..."
            cleanWs()
        }
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
