pipeline {
    agent {
        kubernetes {
            label 'ultimate-cicd-dind'
            defaultContainer 'jnlp'
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: maven
    image: maven:3.9.12-eclipse-temurin-17
    command:
    - cat
    tty: true
  - name: docker
    image: docker:24.0-dind
    securityContext:
      privileged: true
    command:
    - dockerd-entrypoint.sh
    tty: true
    volumeMounts:
      - name: docker-graph-storage
        mountPath: /var/lib/docker
  volumes:
    - name: docker-graph-storage
      emptyDir: {}
"""
        }
    }

    environment {
        DOCKER_IMAGE = "fazil2664/ultimate-cicd:${BUILD_NUMBER}"
        APP_PATH = "java-maven-sonar-argocd-helm-k8s/spring-boot-app"
        DEPLOYMENT_PATH = "java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml"
    }

    stages {

        stage('Checkout') {
            steps {
                echo "Checking out code..."
                git branch: 'main', url: 'https://github.com/fasil7170/Jenkins-Zero-To-Hero.git'
            }
        }

        stage('Build and Test') {
            steps {
                container('maven') {
                    sh """
                        cd ${APP_PATH}
                        mvn clean package
                    """
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                container('maven') {
                    withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                        sh """
                            cd ${APP_PATH}
                            mvn sonar:sonar -Dsonar.login=\$SONAR_AUTH_TOKEN -Dsonar.host.url=http://192.168.0.100:9000
                        """
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            steps {
                container('docker') {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-creds',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )]) {
                        sh """
                            echo "Waiting for Docker daemon to start..."
                            timeout=60
                            until docker info > /dev/null 2>&1 || [ \$timeout -le 0 ]; do
                                echo "Docker daemon not ready, waiting..."
                                sleep 5
                                timeout=\$((timeout - 5))
                            done

                            if [ \$timeout -le 0 ]; then
                                echo "Docker daemon failed to start"
                                exit 1
                            fi

                            echo "\$DOCKER_PASSWORD" | docker login -u "\$DOCKER_USERNAME" --password-stdin
                            docker build -t ${DOCKER_IMAGE} ${APP_PATH}
                            docker push ${DOCKER_IMAGE}
                        """
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                container('maven') {
                    dir("${WORKSPACE}") {
                        withCredentials([string(credentialsId: 'github-creds', variable: 'GITHUB_TOKEN')]) {
                            script {
                                sh """
                                    git config user.email "fasilmubarak07@gmail.com"
                                    git config user.name "fasil7170"
                                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" ${DEPLOYMENT_PATH}
                                """

                                def branch = sh(script: "git rev-parse --abbrev-ref HEAD", returnStdout: true).trim()
                                
                                sh """
                                    git remote set-url origin https://\$GITHUB_TOKEN@github.com/fasil7170/Jenkins-Zero-To-Hero.git
                                    if [ -n "\$(git status --porcelain)" ]; then
                                        git add ${DEPLOYMENT_PATH}
                                        git commit -m "Update image to ${BUILD_NUMBER}"
                                        git push origin HEAD:${branch}
                                    else
                                        echo "No changes to commit."
                                    fi
                                """
                            }
                        }
                    }
                }
            }
        }

    }
}
