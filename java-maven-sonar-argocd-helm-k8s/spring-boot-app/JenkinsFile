podTemplate(
    label: 'ultimate-demo',
    containers: [
        containerTemplate(
            name: 'jnlp',
            image: 'jenkins/inbound-agent:latest',
            ttyEnabled: true
        ),
        containerTemplate(
            name: 'maven',
            image: 'maven:3.9.6-eclipse-temurin-17',
            command: 'cat',       // keeps container alive
            ttyEnabled: true
        ),
        containerTemplate(
            name: 'kaniko',
            image: 'gcr.io/kaniko-project/executor:latest',
            ttyEnabled: true       // keep container alive for executor
        )
    ]
) {
    node('ultimate-demo') {
        stage('Checkout') {
            checkout scm
        }

        stage('Build & Test') {
            container('maven') {
                sh 'mvn clean install'
            }
        }

        stage('Static Code Analysis') {
            container('maven') {
                sh 'mvn sonar:sonar -Dsonar.projectKey=demo-project -Dsonar.host.url=$SONAR_URL -Dsonar.login=$SONAR_TOKEN'
            }
        }

        stage('Build & Push Docker Image') {
            container('kaniko') {
                withCredentials([usernamePassword(credentialsId: 'docker-hub', usernameVariable: 'DOCKER_USERNAME', passwordVariable: 'DOCKER_PASSWORD')]) {
                    sh """
                    /kaniko/executor \\
                        --dockerfile=Dockerfile \\
                        --context=dir://\$WORKSPACE \\
                        --destination=\$DOCKER_USERNAME/ultimate-demo:latest \\
                        --skip-tls-verify \\
                        --cache=true
                    """
                }
            }
        }
    }
}
