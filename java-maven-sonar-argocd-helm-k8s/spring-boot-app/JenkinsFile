pipeline {
    agent {
        kubernetes {
            label 'ultimate-demo'
            defaultContainer 'jnlp'
            yaml """
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: jnlp
    image: jenkins/inbound-agent:latest
    tty: true
  - name: maven
    image: maven:3.9.6-eclipse-temurin-17-jdk
    command:
      - cat
    tty: true
  - name: kaniko
    image: gcr.io/kaniko-project/executor:latest
    command:
      - sh
      - -c
      - "while true; do sleep 30; done;"
    tty: true
  volumes:
  - name: kaniko-cache
    emptyDir: {}
"""
        }
    }

    environment {
        IMAGE_NAME = "yourdockerhubusername/demo-app:latest"
    }

    stages {
        stage('Checkout') {
            steps {
                container('jnlp') {
                    git url: 'https://github.com/fasil7170/Jenkins-Zero-To-Hero/', branch: 'main'
                }
            }
        }

        stage('Build') {
            steps {
                container('maven') {
                    sh 'mvn clean package -DskipTests'
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                container('kaniko') {
                    sh """
                    /kaniko/executor \\
                        --dockerfile=\$WORKSPACE/spring-boot-app/Dockerfile \\
                        --context=dir://\$WORKSPACE/spring-boot-app \\
                        --destination=$IMAGE_NAME \\
                        --cache=true \\
                        --cache-dir=/kaniko
                    """
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline finished!"
        }
        success {
            echo "Pipeline completed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
